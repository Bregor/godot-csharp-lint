root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.cs]
indent_size = 4

# ---------------------------------------------------------------------------
# Nullable reference types
#
# Directory.Build.props sets <Nullable>enable</Nullable>. Godot assigns node
# references in _Ready() rather than in the constructor, so CS8618 fires on
# essentially every node field - that noise is what this suppression removes.
#
# It is deliberately this one rule and not <Nullable>annotations</Nullable>:
# "annotations" would disable the entire warning context, taking CS8602
# (dereference of a possibly null reference) with it, and CS8602 is the rule
# that catches the crashes.
# ---------------------------------------------------------------------------

dotnet_diagnostic.CS8618.severity = none

# ---------------------------------------------------------------------------
# Roslynator
#
# Every RCS rule ships at `note`, which is below the warning threshold the gate
# enforces - so without this line Roslynator.Analyzers never fails `make lint`
# and only ever contributes through `make fix`. Promoting the category is what
# makes it part of the gate.
#
# Measured on a small real Godot project (9 scripts, ~700 lines) before adding
# this line, to size the cost honestly:
#
#   at `note`      8 findings / 3 rules   -> 4 remain after `make fix`
#   at `warning`   7 findings / 3 rules   -> 4 remain after `make fix`
#
# The counts barely move because `make fix` already applies RCS fixes at
# --severity info; promotion changes what *blocks*, not what gets cleaned up.
# Note that promoting a category also enables rules that ship disabled - two of
# them appeared on that project, both auto-fixable.
#
# The 4 survivors were all RCS1163 (unused parameter), which has no Fix All and
# was a genuine bug: four methods took a `bool` they never read. That is the
# case for turning this on - it is the findings without mechanical fixes that
# are worth a gate.
#
# Comment this out if you would rather Roslynator stayed advisory.
# ---------------------------------------------------------------------------

dotnet_analyzer_diagnostic.category-roslynator.severity = warning

# ---------------------------------------------------------------------------
# Analyzer severities
#
# Most of what follows is pre-staged, commented out, for when AnalysisMode is
# raised to "All" (see the note in Directory.Build.props). At that point these
# rules start firing on ordinary Godot conventions rather than on real problems.
#
# CA1050 and CA1051 are the exceptions: both fire at Recommended already, on
# externally visible types and members only, so declaring your script *classes*
# `internal` silences both without any suppression - measured on a real project,
# that one change removed 14 findings. Only the type's visibility matters;
# marking individual members `internal` rather than `public` changes nothing for
# any analyzer. See the "internal classes, private members" section of the README.
#
# They are handled differently below. CA1050 is off, because what it asks for -
# a namespace - is not what Godot does. CA1051 stays on: it is the gate's way of
# noticing a script that is still public, and it is meant to be silenced case by
# case rather than globally.
# ---------------------------------------------------------------------------

# Engine callbacks are named _Ready / _PhysicsProcess / _EnterTree. The
# underscore is required by Godot, not a naming slip.
# dotnet_diagnostic.CA1707.severity = none

# Namespaces. CA1050 and RCS1110 ask for the same thing, and neither is worth
# obeying here, so both are off.
#
# Godot's "new C# script" templates emit `public partial class X : Y` with no
# namespace, so a script trips these before it contains a line of your code, and
# the answer they want - wrap scene scripts in a namespace - is not what Godot
# does. Namespaces work fine (the generators emit ScriptPathAttribute inside
# them correctly) and suit shared utility code; adopting them because an
# analyzer asked is the tail wagging the dog.
#
# Two lines because they land on different code, so one does not cover the other:
#
#   CA1050  - public types only.
#   RCS1110 - any visibility, so `internal` does not clear it. Node scripts are
#             exempt for free: the generators emit partial declarations and the
#             rule skips types with generated parts, which leaves plain helper
#             classes.
#
# Visibility is still enforced, by CA1051 below - that rule stays on.
dotnet_diagnostic.CA1050.severity = none
dotnet_diagnostic.RCS1110.severity = none

# CA1051 is ON, and this suppression is left commented on purpose - it is the
# one rule here meant to be silenced case by case rather than globally.
#
# It needs both halves to be externally visible, so it fires exactly on the
# shape Godot's template steers you into:
#
#   public class + public field  -> CA1051
#   public class + internal field -> silent
#   internal class + public field -> silent
#
# Which means it stays quiet on a freshly created empty script and speaks up the
# moment you add `[Export] public float Speed`. The fix is `internal` on either
# half; [Export] works identically on internal members. For a field that really
# is public API:
#
#   [SuppressMessage("Design", "CA1051:Do not declare visible instance fields",
#       Justification = "Tuned from another assembly at runtime.")]
#
# Uncomment only to turn the convention off project-wide.
# dotnet_diagnostic.CA1051.severity = none

# Unused parameters. A signal handler's signature is dictated by the signal, and
# Godot's generated dispatch checks the argument count exactly, so a parameter
# you do not read cannot simply be deleted - `OnBodyEntered(Node3D body)` has to
# keep taking a body. These two are the live rules for that; RCS1163 fires by
# default here because the Roslynator category is promoted above.
#
# Do not reach for CA1801: it is a legacy FxCop id that was never ported to the
# Roslyn analyzers and does not fire even when set to warning explicitly. The
# SDK silently ignores unknown ids, so configuring it looks like it works.
# dotnet_diagnostic.RCS1163.severity = none
# dotnet_diagnostic.IDE0060.severity = none

# CA1852 (seal internal types) is left ON: sealing Godot node scripts is safe,
# because the engine never subclasses them. Uncomment only if you intend to
# subclass your own node scripts.
# dotnet_diagnostic.CA1852.severity = none

# CA1812 (avoid uninstantiated internal classes) is the one to uncomment first
# if you raise AnalysisMode to All. Godot instantiates node scripts from the
# scene tree, never with `new`, so the analyzer sees zero constructions and
# flags every single script in the project. It is triggered precisely by taking
# this bundle's own advice to make script classes internal, so the two would
# otherwise contradict each other.
# dotnet_diagnostic.CA1812.severity = none

# CA2007 is the one on this list you should not merely silence but actively
# distrust: unlike the rest, following its advice introduces bugs.
#
# GodotSharp installs a GodotSynchronizationContext, which is what makes an
# `await` resume on the main loop. ConfigureAwait(false) opts out of exactly
# that, so the continuation resumes on a thread-pool thread and every scene
# tree touch after the await becomes a race. Leave this suppression in place
# even if you keep the others commented out.
dotnet_diagnostic.CA2007.severity = none

# Same reasoning, for Meziantou.Analyzer's equivalent rule.
dotnet_diagnostic.MA0004.severity = none

# CA1711 objects to type names ending in EventHandler. Godot requires exactly
# that for signals, and not as a convention - the generator refuses to compile
# without it:
#
#   error GD0201: The name of the delegate 'Bus.PingHandler' must end with
#   'EventHandler'
#
# So the rule fires on code the engine will not accept any other way. It also
# covers other reserved suffixes (Collection, Dictionary, Ex), which is the
# small price for not annotating every [Signal] delegate in the project.
dotnet_diagnostic.CA1711.severity = none

# ---------------------------------------------------------------------------
# Meziantou.Analyzer
#
# Complementary to Roslynator rather than an alternative: measured on a real
# project, the two produced 12 and 20 findings with *zero* overlapping
# locations. What each is for differs too - Roslynator does micro-refactoring
# that `make fix` mostly applies by itself, Meziantou does correctness.
#
# Two of its rules have to go, or it undoes decisions made elsewhere in this
# file and double-reports a third:
# ---------------------------------------------------------------------------

# MA0047 is the third copy of the namespace demand, after CA1050 and RCS1110
# above. Same reasoning, same answer.
dotnet_diagnostic.MA0047.severity = none

# MA0038 is deprecated in favour of CA1822 - its own message says so - and CA1822
# is already on. Measured on a real project they reported the same five members.
dotnet_diagnostic.MA0038.severity = none

# Left ON deliberately, because they are the reason to install the package:
#
#   MA0076 - implicit culture-sensitive ToString in an interpolated string.
#            `$"{speed}"` on a float uses the current culture, so a machine with
#            a comma decimal separator writes "1,5". Cosmetic on a HUD, a bug in
#            a save file or a network packet. See the note below.
#   MA0048 - file name must match type name. Style elsewhere, correctness here:
#            Godot's generator emits ScriptPathAttribute only for the file whose
#            name matches the type, so a mismatch leaves the class unregistered
#            and unattachable, with no compiler error. Partial types split across
#            files are the one false positive - Godot handles those by binding to
#            the matching file.
#
# MA0076 objects to the culture being *implicit*, not to any particular culture,
# so stating either one silences it for good - the choice stays yours. `make fix`
# only rewrites the form that has not chosen yet, and it picks invariant, which
# is right for a save file and arguable for a HUD. Measured:
#
#   $"{speed:F1}"                                          fires; fix rewrites
#   string.Create(CultureInfo.CurrentCulture, $"...")      clean
#   string.Create(CultureInfo.InvariantCulture, $"...")    clean
#   $"{speed.ToString("F1", CultureInfo.CurrentCulture)}"  clean
#   FormattableString.Invariant($"...")                    FALSE POSITIVE
#
# That last one is the trap. FormattableString.Invariant is the canonical
# explicit-invariant form and the analyzer does not recognise it, so `make fix`
# wraps it in string.Create and you end up applying invariant twice. If you use
# it, suppress in place:
#
#   [SuppressMessage("Usage", "MA0076:Do not use implicit culture-sensitive ToString",
#       Justification = "FormattableString.Invariant already fixes the culture.")]

# ---------------------------------------------------------------------------
# Third-party addons.
#
# Godot installs plugins into addons/, and Godot.NET.Sdk compiles every .cs
# under the project root - so plugin sources are part of your compilation and
# their findings fail your gate. .csharpierignore keeps the formatter out;
# this keeps the analyzers out.
#
# `generated_code = true` rather than `dotnet_analyzer_diagnostic.severity`:
# the bulk-severity option is outranked by the per-rule entries the SDK emits
# for AnalysisMode, so it has no effect here. This does work, and it means
# "code this repo did not author" - which is what addons/ is.
#
# Caveat: this covers analyzer rules (CA/RCS/IDE) but NOT compiler warnings,
# which have to be listed individually. CS0414 is pre-listed because vendored
# code hits it constantly; add others as you meet them.
# ---------------------------------------------------------------------------

[addons/**.cs]
generated_code = true
dotnet_diagnostic.CS0414.severity = none

# ---------------------------------------------------------------------------
# Godot-authored files. Godot owns the exact bytes of these; trimming or
# appending would produce spurious diffs and can corrupt them.
#
# .uid covers the sidecars Godot 4.4+ writes next to scripts and resources
# (Player.cs.uid); harmless to list on older versions, which just never
# generate them.
# ---------------------------------------------------------------------------

[*.{tscn,tres,godot,import,uid}]
trim_trailing_whitespace = false
insert_final_newline = false

# ---------------------------------------------------------------------------
# GDScript. The [*] block above sets spaces, but Godot's own style guide and
# its editor both use tabs, so without this an editor honouring .editorconfig
# fights the Godot editor over every .gd file in a mixed-language project.
# ---------------------------------------------------------------------------

[*.{gd,gdshader,gdshaderinc}]
indent_style = tab
