<Project>
  <!--
    Central analyzer configuration. Referenced automatically by every project
    at or below this directory. This is the "one config" that aggregates your
    linters, the way .golangci.yml aggregates linters for golangci-lint.
  -->

  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>

    <!--
      "latest" tracks whichever SDK is installed, so the rule set - and with it
      the set of findings - changes when the SDK does. That is fine while the
      team is on one SDK and turns into "passes on my machine, fails in CI" when
      it is not. Pin to a number here (e.g. 9.0) when that starts to matter;
      this is the right file for it, because the Godot editor's own builds read
      it too and never see the Makefile.

      To try a level before committing to it: make lint ANALYSIS_LEVEL=9.0
    -->
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Recommended is a sane starting point. Bump to "All" once the codebase is clean. -->
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!--
      "enable", with CS8618 silenced in .editorconfig instead.

      Godot assigns node references in _Ready(), not in the constructor, so the
      obvious workaround for that noise is <Nullable>annotations</Nullable>.
      Don't: "annotations" turns off the whole warning context, not just the
      constructor rule, so CS8602 ("dereference of a possibly null reference")
      goes silent too - and that is the one that catches real null crashes.
      Suppressing CS8618 alone kills the Godot noise and keeps the rest.
    -->
    <Nullable>enable</Nullable>

    <!--
      TreatWarningsAsErrors is intentionally NOT set here.
      Local dev builds stay non-fatal; the `lint` target enforces via
      `dotnet build -warnaserror` (see the Makefile). This mirrors how
      golangci-lint is a separate gate rather than part of every `go build`.
    -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Run `dotnet list package` with the outdated flag to bump. -->
    <PackageReference Include="Roslynator.Analyzers" Version="4.16.0" PrivateAssets="all" />

    <!--
      Meziantou complements Roslynator rather than competing with it. Measured
      on a real Godot project, the two reported 12 and 20 findings with zero
      overlapping locations, and they are different in kind: Roslynator does
      micro-refactoring that `make fix` mostly applies on its own, Meziantou
      does correctness.
    -->
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.141" PrivateAssets="all" />
  </ItemGroup>
</Project>
